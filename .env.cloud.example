# DataSuite - Cloud Configuration Example
# Copy this to .env and fill in your values

# ========== REQUIRED ==========

# Application IDs (get from your auth provider)
APP_ID=your_app_id
APP_SECRET=your_app_secret

# PlanetScale Cloud Database (MySQL)
# Format: mysql://username:password@region.psdb.cloud/datasuite?sslaccept=skip
# Get this from: https://app.planetscale.com/datasuite/connect
DATABASE_URL=mysql://root:your_planetscale_password@aws.connect.psdb.cloud/datasuite?sslaccept=skip

# Node environment
NODE_ENV=production

# ========== CLOUD CODE EXECUTION ==========

# Replit API Key (get from: https://replit.com/account)
# This enables Python, R, JavaScript, SQL execution in cloud
REPLIT_API_KEY=your_replit_api_key_here

# ========== AUTH URLS ==========

# Kimi AI Authentication
KIMI_AUTH_URL=https://kimi.moonshot.cn/auth
KIMI_OPEN_URL=https://kimi.moonshot.cn

# Owner identification
OWNER_UNION_ID=email:your-email@example.com

# ========== OPTIONAL: OAUTH PROVIDERS ==========

# Google OAuth (for login)
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Yandex OAuth (for login)
# Get from: https://oauth.yandex.com
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret

# ========== NOTES ==========

# After deployment to Railway:
# 1. Add these variables to Railway project settings
# 2. Railway will auto-redeploy when variables change
# 3. Frontend users can then access at: https://your-railway-url
# 4. Code execution works instantly on Replit servers
# 5. Database queries run on PlanetScale MySQL
# 6. Works on Android, iOS, desktop browsers
